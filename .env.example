# AnnaSetu AI — Environment Configuration Template (.env.example)
# DO NOT store real credentials in this file. Copy to .env and fill in values securely.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info

# FastAPI Service Config
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Supabase (Auth, PostgreSQL Database, Private Storage, Realtime)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
SUPABASE_STORAGE_BUCKET_FOOD_PHOTOS=food-photos-private

# Vision & LLM Model Adapter (Evidence Assessment)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-or-openai-api-key-placeholder
LLM_MODEL_NAME=gemini-1.5-flash

# Maps & Geocoding Adapter (Distance & Travel Feasibility)
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-placeholder
MAPBOX_ACCESS_TOKEN=your-mapbox-token-placeholder

# Notifications (Push via Expo, Email via Resend, WhatsApp)
NOTIFICATIONS_PROVIDER=mock
EXPO_ACCESS_TOKEN=your-expo-access-token-placeholder
RESEND_API_KEY=your-resend-api-key-placeholder
WHATSAPP_API_TOKEN=your-whatsapp-token-placeholder

# Public Web / Operations Console (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
